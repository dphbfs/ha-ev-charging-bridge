HA_URL=http://homeassistant.local:8123
HA_TOKEN=replace-with-home-assistant-long-lived-access-token
HA_EVENT_TYPE=state_changed
DEVICE_CONFIG=devices.yaml

SESSION_START_THRESHOLD_W=200
SESSION_END_THRESHOLD_W=50
SESSION_END_DEBOUNCE=10s
INGRESS_STORE=var/ingress-events.jsonl
ACTIVE_SESSION_STORE=var/current-session.json
SESSION_STORE=var/sessions.jsonl
LOG_FILE=log/app.log
